# Copy to .env and set passwords. .env is git-ignored.
ABS_URL=http://localhost:13378
ABS_ROOT_USER=root
ABS_ROOT_PASSWORD=change-me
ABS_TEST_USER=wear
ABS_TEST_PASSWORD=change-me
# Server URL as seen from the watch/emulator (used by tool/e2e.sh)
ABS_E2E_URL=http://<server-lan-ip>:13378
# SSO tests: Authentik as seen from the watch/emulator (and from ABS).
AUTHENTIK_URL=http://<server-lan-ip>:9000
# Letters and digits only (Docker Compose expands "$"), e.g. openssl rand -hex 32
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_PG_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=change-me
ABS_OIDC_CLIENT_SECRET=change-me
