# Copy to .env (git-ignored). Secrets alphanumeric only: Compose would
# expand a "$".

# Where the watch (and ABS) reach the two servers. Authelia insists on
# HTTPS; setup.sh makes a test CA and a certificate for IDP_HOST (an IP or
# a hostname).
IDP_HOST=<server-lan-ip-or-hostname>
IDP_PORT=9002
ABS_PORT=13382
ABS_PUBLIC_URL=http://<server-lan-ip>:13382

# The books to serve (read-only), e.g. the main test server's.
AUDIOBOOKS_DIR=../../data/audiobooks

ABS_ROOT_USER=root
ABS_ROOT_PASSWORD=change-me

# Authelia users. ABS creates their accounts on the first SSO login.
# ABS_TEST_USER needs a password only; ABS_TOTP_USER also a TOTP code from
# ABS_TOTP_SECRET (base32, 32 characters A-Z2-7).
ABS_TEST_USER=wear
ABS_TEST_PASSWORD=change-me
ABS_TOTP_USER=weartotp
ABS_TOTP_PASSWORD=change-me
ABS_TOTP_SECRET=CHANGEMECHANGEMECHANGEMECHANGEME

ABS_OIDC_CLIENT_SECRET=change-me
IDP_JWT_SECRET=change-me
IDP_SESSION_SECRET=change-me
IDP_STORAGE_KEY=change-me-at-least-20-characters
IDP_OIDC_HMAC_SECRET=change-me
