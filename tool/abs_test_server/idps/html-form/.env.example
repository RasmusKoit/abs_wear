# Copy to .env and fill in. Letters and digits only (Compose expands "$"),
# e.g. openssl rand -hex 16. .env is git-ignored.
ABS_PORT=13381
KEYCLOAK_PORT=9001
GITEA_PORT=9011
# The servers as the watch (and ABS) reach them: the host's LAN address.
ABS_URL=http://<server-lan-ip>:13381
KEYCLOAK_URL=http://<server-lan-ip>:9001
GITEA_URL=http://<server-lan-ip>:9011
# Book library mounted read-only (see ../../generate_media.sh).
AUDIOBOOKS_DIR=/home/you/code/abs-wear-test/data/audiobooks
ABS_ROOT_USER=root
ABS_ROOT_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
ABS_OIDC_CLIENT_SECRET=change-me
# Password-only user.
ABS_TEST_USER=wear
ABS_TEST_PASSWORD=change-me
# User with a TOTP second factor. The secret's ASCII bytes are the TOTP key
# (Keycloak's own format), e.g. 20 random letters and digits.
ABS_OTP_USER=wear-otp
ABS_OTP_PASSWORD=change-me
ABS_OTP_SECRET=change-me
# Which provider ABS uses: keycloak or gitea (needs --profile gitea).
ABS_IDP=keycloak
# Gitea: admin "abs-admin", and the users (same passwords as above; Gitea
# makes up the TOTP secret, see README.md).
GITEA_ADMIN_PASSWORD=change-me
ABS_GITEA_USER=wear-gitea
ABS_GITEA_OTP_USER=wear-gitea-otp
