# Copy to .env and replace every change-me (letters and digits only).
# URLs as the watch sees them (the dev box's LAN address).
ABS_URL=http://<server-lan-ip>:13384
LOGTO_URL=http://<server-lan-ip>:9004
LOGTO_ADMIN_URL=http://<server-lan-ip>:9005
# Test books, mounted read-only (made by tool/abs_test_server).
ABS_AUDIOBOOKS=../abs-wear-test/data/audiobooks
LOGTO_PG_PASSWORD=change-me
ABS_ROOT_USER=root
ABS_ROOT_PASSWORD=change-me
# The Logto user the watch logs in as (password only).
ABS_TEST_USER=wear
ABS_TEST_PASSWORD=change-me
# A second Logto user with a TOTP authenticator (base32 secret).
ABS_MFA_USER=wear_mfa
ABS_MFA_PASSWORD=change-me
ABS_MFA_TOTP_SECRET=CHANGEME
# Machine-to-machine app that setup.sh uses for Logto's Management API.
LOGTO_M2M_SECRET=change-me
