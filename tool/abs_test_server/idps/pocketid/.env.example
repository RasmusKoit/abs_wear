# Copy to .env and replace every change-me (alphanumeric only).
# URLs as the watch sees them (the dev box's LAN address).
ABS_URL=http://<server-lan-ip>:13387
ABS_PORT=13387
# A host name (resolving to the dev box), not an IP: Pocket ID refuses IP
# addresses.
POCKET_ID_URL=http://<server-hostname>:9007
POCKET_ID_PORT=9007
AUDIOBOOKS_DIR=../abs-wear-test/data/audiobooks
ABS_ROOT_USER=root
ABS_ROOT_PASSWORD=change-me
# The Pocket ID user ABS Wear logs in as (passkeys only, no password).
ABS_TEST_USER=wear
POCKET_ID_ENCRYPTION_KEY=change-me-at-least-16-chars
POCKET_ID_API_KEY=change-me-at-least-16-chars
ABS_OIDC_CLIENT_SECRET=change-me-at-least-16-chars
