# Copy to .env and replace every change-me (alphanumeric only: Compose
# would expand a "$"). .env is git-ignored.
ABS_PORT=13383
TINYAUTH_PORT=9003
# ABS and tinyauth as seen from the watch (and from each other). tinyauth
# needs a host name, not an IP address.
ABS_URL=http://<dev-box-lan-ip>:13383
TINYAUTH_URL=https://<dev-box-host-name>:9003
AUDIOBOOKS_DIR=/path/to/abs-wear-test/data/audiobooks
ABS_ROOT_USER=root
ABS_ROOT_PASSWORD=change-me
ABS_OIDC_CLIENT_SECRET=change-me
# tinyauth users (ABS creates their accounts on the first SSO login).
ABS_TEST_USER=wear
ABS_TEST_PASSWORD=change-me
TOTP_USER=wear-totp
TOTP_PASSWORD=change-me
# Base32, e.g. python3 -c 'import base64,os;print(base64.b32encode(os.urandom(20)).decode())'
TOTP_SECRET=CHANGEME
