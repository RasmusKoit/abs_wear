# Copy to .env and replace every change-me (alphanumeric values only).
# URLs as seen from the watch.
ABS_URL=http://192.168.3.123:13386
VOIDAUTH_URL=http://192.168.3.123:9006
# Defaults to the main test server's books.
# AUDIOBOOKS_DIR=../abs-wear-test/data/audiobooks

ABS_ROOT_USER=root
ABS_ROOT_PASSWORD=change-me

# At least 32 characters.
VOIDAUTH_STORAGE_KEY=change-me
# Password setup.sh gives VoidAuth's built-in admin (auth_admin).
VOIDAUTH_ADMIN_PASSWORD=change-me
ABS_OIDC_CLIENT_SECRET=change-me

# Password-only VoidAuth user.
ABS_TEST_USER=wear
ABS_TEST_PASSWORD=change-me
# VoidAuth user with a TOTP second factor (VoidAuth usernames: [A-Za-z0-9_]).
ABS_TOTP_USER=wear_totp
ABS_TOTP_PASSWORD=change-me
# Filled in by setup.sh: the TOTP secret VoidAuth generated for ABS_TOTP_USER.
# VOIDAUTH_TOTP_SECRET=
